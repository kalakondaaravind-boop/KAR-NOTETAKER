<?xml version="1.0" encoding="utf-8"?>
<!-- Defence in depth: the app has no INTERNET permission; should that ever change, cleartext is still refused everywhere. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
