<?xml version="1.0" encoding="utf-8"?>
<!--
  Android cloud backup and device-to-device transfer are disabled for note content: the user controls
  backups explicitly (Settings → Data → Backup), optionally encrypted with their own passphrase.
  Keystore-encrypted secrets cannot be restored on another device and are always excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
